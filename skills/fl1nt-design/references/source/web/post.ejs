<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/metadata') %>
  </head>
  <body class="crt">
    <div class="crt-glow"></div>
    <div id="crt" class="crt">
      <%- include('partials/header') %>
      <%- include('partials/nav', { currentPage: 'blog' }) %>
      <main class="content post-layout">
        <div class="post-content-wrapper">
          <section class="browser-window">
            <div class="browser-header">
              <div class="browser-controls">
                <span class="control close"></span>
                <span class="control minimize"></span>
                <span class="control maximize"></span>
              </div>
              <span class="browser-title">fl1nt.dev - <%= post.title %></span>
              <div class="browser-actions">
                <span class="action">View</span>
                <span class="action">Share</span>
                <span class="action">Bookmark</span>
              </div>
            </div>
            <div class="browser-tabs">
              <div class="tab active">
                <span class="tab-icon">•</span>
                <span class="tab-name"><%= post.title %></span>
                <span class="tab-close">×</span>
              </div>
              <div class="tab">
                <span class="tab-icon">+</span>
                <span class="tab-name">New Tab</span>
                <span class="tooltip">its just for effect lol</span>
              </div>
            </div>
            <div class="browser-toolbar">
              <div class="nav-buttons">
                <% if (previousPost) { %>
                  <a href="/blog/<%= previousPost.slug %>" class="nav-btn" title="Previous Post: <%= previousPost.title %>">←</a>
                <% } else { %>
                  <button class="nav-btn disabled" title="No previous post" disabled>←</button>
                <% } %>
                <% if (nextPost) { %>
                  <a href="/blog/<%= nextPost.slug %>" class="nav-btn" title="Next Post: <%= nextPost.title %>">→</a>
                <% } else { %>
                  <button class="nav-btn disabled" title="No next post" disabled>→</button>
                <% } %>
                <button class="nav-btn" title="Reload" onclick="window.location.reload()">↻</button>
              </div>
              <div class="address-bar">
                <div class="security-icon">[S]</div>
                <div class="url">https://fl1nt.dev/blog/<%= post.slug %></div>
              </div>
            </div>
            
            <div class="browser-body">
              <article class="browser-content">
              <div class="webpage-meta">
                <div class="page-breadcrumb">
                  <a href="/" class="breadcrumb-link">home</a>
                  <span class="breadcrumb-separator">/</span>
                  <a href="/blog" class="breadcrumb-link">blog</a>
                  <span class="breadcrumb-separator">/</span>
                  <span class="breadcrumb-current"><%= post.slug %></span>
                </div>
                <div class="page-meta">
                  <span class="page-date">Published: <%- post.date %></span>
                  <% if (post.readTime) { %>
                    <span class="page-read-time">• <%= post.readTime %> min read</span>
                  <% } %>
                  <% if (post.published === false) { %>
                    <span class="page-draft-badge">draft</span>
                  <% } %>
                  <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    <a class="page-edit-link" href="/blog/<%= post.slug %>/edit">edit post</a>
                  <% } %>
                </div>
              </div>
              
              <header class="page-header">
                <h1 class="page-title"><%= post.title %></h1>
                <% if (post.excerpt) { %>
                  <p class="page-excerpt"><%= post.excerpt %></p>
                <% } %>
              </header>
              
              <div class="page-content">
                <%- post.content %>
              </div>
              
              <div class="post-footer">
                <div class="post-footer-content">
                  <div class="footer-actions">
                    <div class="action-group">
                      <a href="/blog" class="action-button secondary">
                        <span class="button-text">Back to Blog</span>
                      </a>
                    </div>
                    <div class="action-group">
                      <button class="action-button share-button" onclick="copyPostLink()">
                        <span class="button-text">Copy Link</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              </article>
            </div>
          </section>


        </div>
        <%- include('partials/sidebar', { blogs: relatedPosts || [], commits: commits || [] }) %>
      </main>
      <%- include('partials/footer') %>
    </div>
    
    <script>
      // Copy post link functionality
      function copyPostLink() {
        const url = window.location.href;
        const shareButton = document.querySelector('.share-button');
        
        try {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(() => {
              showCopyFeedback(shareButton, true);
            }).catch(() => {
              fallbackCopy(url, shareButton);
            });
          } else {
            fallbackCopy(url, shareButton);
          }
        } catch (err) {
          fallbackCopy(url, shareButton);
        }
      }

      function fallbackCopy(text, button) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand('copy');
          showCopyFeedback(button, true);
        } catch (err) {
          showCopyFeedback(button, false);
        } finally {
          document.body.removeChild(textArea);
        }
      }

      function showCopyFeedback(button, success) {
        const originalText = button.querySelector('.button-text').textContent;
        const buttonText = button.querySelector('.button-text');
        
        if (success) {
          buttonText.textContent = 'Copied!';
          button.classList.add('success');
        } else {
          buttonText.textContent = 'Failed';
          button.classList.add('error');
        }
        
        setTimeout(() => {
          buttonText.textContent = originalText;
          button.classList.remove('success', 'error');
        }, 2000);
      }

      // Smooth scrolling for anchor links within post content
      document.addEventListener('DOMContentLoaded', function() {
        const links = document.querySelectorAll('.article-content a[href^="#"]');
        links.forEach(link => {
          link.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
              target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
              });
            }
          });
        });

        // Add copy buttons to code blocks
        const codeBlocks = document.querySelectorAll('.article-content pre code');
        codeBlocks.forEach(block => {
          const pre = block.parentElement;
          if (pre.querySelector('.code-copy-btn')) return; // Already has button
          
          const copyBtn = document.createElement('button');
          copyBtn.className = 'code-copy-btn';
          copyBtn.innerHTML = '<span class="copy-icon">[]</span>';
          copyBtn.title = 'Copy code';
          
          copyBtn.addEventListener('click', () => {
            const code = block.textContent;
            navigator.clipboard.writeText(code).then(() => {
              copyBtn.innerHTML = '<span class="copy-icon">+</span>';
              copyBtn.classList.add('copied');
              setTimeout(() => {
                copyBtn.innerHTML = '<span class="copy-icon">[]</span>';
                copyBtn.classList.remove('copied');
              }, 2000);
            });
          });
          
          pre.style.position = 'relative';
          pre.appendChild(copyBtn);
        });
      });
    </script>
    <%- include('partials/scripts') %>
  </body>
</html> 