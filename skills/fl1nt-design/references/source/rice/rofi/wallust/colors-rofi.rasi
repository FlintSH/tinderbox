 /* fl1nt palette - hardcoded, no longer generated by wallust */
 /* Source of truth: ~/.config/hypr/fl1nt-colors.conf */

* {
active-background: #867cff;
active-foreground: #000000;
normal-background: #000000;
normal-foreground: #ffffff;
urgent-background: #ff4444;
urgent-foreground: #ffffff;

alternate-active-background: #6b63cc;
alternate-active-foreground: #ffffff;
alternate-normal-background: #000000;
alternate-normal-foreground: #cfcfcf;
alternate-urgent-background: #000000;
alternate-urgent-foreground: #ff4444;

selected-active-background: #a499ff;
selected-active-foreground: #000000;
selected-normal-background: #867cff;
selected-normal-foreground: #000000;
selected-urgent-background: #ff4444;
selected-urgent-foreground: #ffffff;

background-color: #000000;
background: rgba(0,0,0,0.85);
foreground: #ffffff;
border-color: #867cff;

color0: #0a0a0a;
color1: #6b63cc;
color2: #7970e5;
color3: #867cff;
color4: #a499ff;
color5: #ff69b4;
color6: #00e5e5;
color7: #cfcfcf;
color8: #4d4d4d;
color9: #6b63cc;
color10: #7970e5;
color11: #867cff;
color12: #a499ff;
color13: #ff69b4;
color14: #00ffff;
color15: #ffffff;
}
